# ============================================
# CloudLab Deployment Configuration
# ============================================
# Copy this file to .env and customize for your setup
# cp .env.example .env

# CloudLab Username
CLOUDLAB_USERNAME=username

# CloudLab Domain (typically cloudlab.us)
CLOUDLAB_DOMAIN=hostdomain

# SSH Configuration
SSH_KEY_PATH=~/.ssh/your_key
SSH_STRICT_HOST_CHECKING=no
SSH_USER_KNOWN_HOSTS_FILE=/dev/null

# CloudLab Nodes (comma-separated list of hostnames without domain)
# Example: clgpu014,clgpu012,clgpu015,clgpu013,clgpu021
CLOUDLAB_NODES=clgpu014,clgpu012,clgpu015,clgpu013,clgpu021

# Remote Directory on CloudLab Nodes
REMOTE_DIR=/users/${CLOUDLAB_USERNAME}/rdma-kv-cache

# Local Project Directory
LOCAL_DIR=$(pwd)

# Build Configuration
BUILD_TYPE=Release
BUILD_JOBS=8

# CUDA Configuration
CUDA_ARCH=sm_80

# Network Configuration
IB_DEVICE=mlx5_0
IB_PORT=1

# Transfer backend selection
# USE_GPU=true  → GPUDirect RDMA (RDMAConnector, requires nvidia-peermem + A100-class GPU)
# USE_GPU=false → Standard RDMA via MooncakeConnector (no GPU required, works on CPU-only servers)
USE_GPU=true

# ============================================
# YAML Configuration Defaults
# ============================================
# These values are used when generating node YAML configs
# Uncomment and modify any value to override the defaults

# Port Configuration
# ORCHESTRATOR_PORT=9000
# VLLM_PREFILL_BASE_PORT=8100
# VLLM_DECODE_BASE_PORT=8200
# NODE_TCP_BASE_PORT=18500

# Model Configuration
# MODEL_NAME=Qwen/Qwen3-8B
# MODEL_MAX_LEN=4096
# GPU_MEMORY_UTILIZATION=0.9
# TENSOR_PARALLEL_SIZE=1

# Cluster Settings
# REPLICATION_FACTOR=3
# NUMBER_OF_KEYS_HASHTABLE=10000
# SIZE_LOCAL_BUFFER=1024
# EVENT_QUEUE_SIZE=1000
# WORKER_POOL_SIZE=4
# VNODES_NUMBER=1
# NUM_LAYERS=32

# RDMA/InfiniBand Configuration
# NODE_GID_INDEX=0              # 0=IB, 3=RoCEv2
# NODE_MTU=0                    # Path MTU: 0=auto-discover (recommended), or override: 256/512/1024/2048/4096
# NODE_SL=0                     # Service Level
# NODE_QP_MAX_SEND_WR=64
# NODE_QP_MAX_RECV_WR=64
# NODE_QP_MAX_INLINE_DATA=64
# NODE_MAX_RD_ATOMIC=16
# NODE_MIN_RNR_TIMER=12         # ~0.64 ms
# NODE_TIMEOUT=14               # local ACK timeout (~67 ms)
# NODE_RETRY_CNT=7
# NODE_RNR_RETRY=7              # 7 = infinite
# NODE_CQ_DEPTH=128

# GPU Configuration
# NODE_ENABLE_PEER_ACCESS=true
# NODE_REQUIRE_SAME_NUMA=false

# Memory Configuration
# MEMORY_KV_BUFFER_MB=16384           # Total GPU memory buffer (16 GB)
# MEMORY_LAYER_SIZE_MB=128            # Per-layer KV cache size (128 MB default, model-dependent)
# MEMORY_CHUNK_SIZE_MB=64             # Size of each chunk (64-128 MB recommended)
# MEMORY_NUM_KV_CHUNKS=32             # Number of chunks per request
# MEMORY_MR_RELAXED_ORDERING=true     # Enable PCIe relaxed ordering for better BW
# MEMORY_MAX_CONCURRENT_REQUESTS=8    # Max simultaneous KV transfers
